<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="addon" label="-1" help="-1">
    <category id="tuner" label="30000" help="-1">
      <group id="1" label="-1">
        <setting id="source_type" type="integer" label="30001" help="30013">
          <level>0</level>
          <default>@DEFAULT_SOURCE_TYPE@</default>
          <constraints>
            <options>
              <option label="30002">0</option>
              <option label="30003">1</option>
            </options>
          </constraints>
          <visible>@USB_SUPPORTED@</visible>
          <control type="list" format="string" />
        </setting>
        <setting id="usb_serial" type="string" label="30004" help="30014">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <dependencies>
            <dependency type="visible" setting="source_type">0</dependency>
          </dependencies>
          <control type="edit" format="string" />
        </setting>
        <setting id="tcp_host" type="string" label="30005" help="30015">
          <level>0</level>
          <default>127.0.0.1</default>
          <dependencies>
            <dependency type="visible" setting="source_type">1</dependency>
          </dependencies>
          <control type="edit" format="string" />
        </setting>
        <setting id="tcp_port" type="integer" label="30006" help="30016">
          <level>0</level>
          <default>1234</default>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>65535</maximum>
          </constraints>
          <dependencies>
            <dependency type="visible" setting="source_type">1</dependency>
          </dependencies>
          <control type="edit" format="integer" />
        </setting>
      </group>
      <group id="2" label="-1">
        <setting id="gain_auto" type="boolean" label="30007" help="30017">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
        <setting id="gain_manual" type="integer" label="30008" help="30018">
          <level>0</level>
          <default>30</default>
          <constraints>
            <minimum>0</minimum>
            <step>1</step>
            <maximum>50</maximum>
          </constraints>
          <dependencies>
            <dependency type="visible" setting="gain_auto">false</dependency>
          </dependencies>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="ppm_correction" type="integer" label="30009" help="30019">
          <level>2</level>
          <default>0</default>
          <constraints>
            <minimum>-200</minimum>
            <step>1</step>
            <maximum>200</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
      </group>
    </category>
    <category id="epg" label="30010" help="-1">
      <group id="1" label="-1">
        <setting id="background_update" type="boolean" label="30011" help="30012">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
      </group>
    </category>
  </section>
</settings>

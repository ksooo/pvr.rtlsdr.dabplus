# Kodi Media Center language file
# Addon Name: RTL-SDR DAB+ Client
# Addon id: pvr.rtlsdr.dabplus
# Addon Provider: ksooo
msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de_DE\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "Addon Summary"
msgid "DAB+ radio with an RTL-SDR USB stick"
msgstr "DAB+-Radio mit einem RTL-SDR-USB-Stick"

msgctxt "Addon Description"
msgid "Receive DAB+ digital radio with an RTL-SDR USB stick, either connected directly or through an rtl_tcp server on another device."
msgstr "DAB+-Digitalradio mit einem RTL-SDR-USB-Stick empfangen, der direkt angeschlossen ist oder über einen rtl_tcp-Server auf einem anderen Gerät bereitsteht."

msgctxt "#30000"
msgid "Tuner"
msgstr "Tuner"

msgctxt "#30001"
msgid "Device"
msgstr "Gerät"

msgctxt "#30002"
msgid "USB stick"
msgstr "USB-Stick"

msgctxt "#30003"
msgid "rtl_tcp server"
msgstr "rtl_tcp-Server"

msgctxt "#30004"
msgid "Serial number (empty: first stick found)"
msgstr "Seriennummer (leer: erster gefundener Stick)"

msgctxt "#30005"
msgid "Server address"
msgstr "Serveradresse"

msgctxt "#30006"
msgid "Server port"
msgstr "Serverport"

msgctxt "#30007"
msgid "Automatic gain control"
msgstr "Automatische Verstärkungsregelung"

msgctxt "#30008"
msgid "Gain (dB)"
msgstr "Verstärkung (dB)"

msgctxt "#30009"
msgid "Frequency correction (ppm)"
msgstr "Frequenzkorrektur (ppm)"

msgctxt "#30010"
msgid "Programme guide"
msgstr "Programmübersicht"

msgctxt "#30011"
msgid "Update programme guide and logos in the background"
msgstr "Programmübersicht und Logos im Hintergrund aktualisieren"

#. Help text of setting with label #30011
msgctxt "#30012"
msgid "While no channel is played, the tuner receives the programme guide and logos of all ensembles after start-up and every six hours."
msgstr "Solange kein Sender wiedergegeben wird, empfängt der Tuner nach dem Start und alle sechs Stunden die Programmübersicht und die Logos aller Ensembles."

#. Help text of setting with label #30001
msgctxt "#30013"
msgid "How the add-on reaches the RTL-SDR stick: plugged into this device, or through an rtl_tcp server that shares a stick on another device in the network."
msgstr "Wie das Addon den RTL-SDR-Stick erreicht: direkt an diesem Gerät angeschlossen oder über einen rtl_tcp-Server, der einen Stick an einem anderen Gerät im Netzwerk bereitstellt."

#. Help text of setting with label #30004
msgctxt "#30014"
msgid "Selects a stick by its serial number when several are connected. If empty, the first stick that is not in use is taken."
msgstr "Wählt bei mehreren angeschlossenen Sticks einen anhand seiner Seriennummer aus. Ist das Feld leer, wird der erste Stick verwendet, der nicht belegt ist."

#. Help text of setting with label #30005
msgctxt "#30015"
msgid "Host name or IP address of the device that runs the rtl_tcp server."
msgstr "Hostname oder IP-Adresse des Geräts, auf dem der rtl_tcp-Server läuft."

#. Help text of setting with label #30006
msgctxt "#30016"
msgid "Port the rtl_tcp server listens on. rtl_tcp uses 1234 unless it was started with another port."
msgstr "Port, auf dem der rtl_tcp-Server lauscht. rtl_tcp verwendet 1234, sofern beim Start kein anderer Port angegeben wurde."

#. Help text of setting with label #30007
msgctxt "#30017"
msgid "Adjusts the gain of the tuner to the strength of the received ensemble. Recommended unless reception needs a fixed gain."
msgstr "Passt die Verstärkung des Tuners an die Stärke des empfangenen Ensembles an. Empfohlen, sofern der Empfang keine feste Verstärkung erfordert."

#. Help text of setting with label #30008
msgctxt "#30018"
msgid "Fixed gain of the tuner. With too little gain weak ensembles are lost, with too much strong ones overload the tuner. The nearest gain the tuner supports is used."
msgstr "Feste Verstärkung des Tuners. Bei zu geringer Verstärkung gehen schwache Ensembles verloren, bei zu hoher übersteuern starke Ensembles den Tuner. Verwendet wird die nächstliegende Stufe, die der Tuner unterstützt."

#. Help text of setting with label #30009
msgctxt "#30019"
msgid "Corrects a frequency error of the stick's crystal, in parts per million. Only needed if no ensembles are found despite good reception; the receiver corrects small errors on its own."
msgstr "Gleicht eine Frequenzabweichung des Quarzes im Stick aus, in Millionstel (ppm). Nur nötig, wenn trotz guten Empfangs keine Ensembles gefunden werden; kleine Abweichungen gleicht der Empfänger selbst aus."

#empty strings from id 30020 to 30099

#. Heading of the channel scan progress dialog
msgctxt "#30100"
msgid "DAB+ channel scan"
msgstr "DAB+-Sendersuche"

#. Channel scan progress, {0:s} is the DAB block (e.g. 5C), {1:.3f} its frequency in MHz
msgctxt "#30101"
msgid "Scanning block {0:s} ({1:.3f} MHz)"
msgstr "Block {0:s} ({1:.3f} MHz) wird durchsucht"

#. Channel scan progress, {0:d} is the number of ensembles found, {1:d} the number of services
msgctxt "#30102"
msgid "Found {0:d} ensembles with {1:d} services"
msgstr "{0:d} Ensembles mit {1:d} Diensten gefunden"

msgctxt "#30103"
msgid "No DAB ensembles were found."
msgstr "Es wurden keine DAB-Ensembles gefunden."

msgctxt "#30104"
msgid "Unable to open the tuner."
msgstr "Der Tuner kann nicht geöffnet werden."

msgctxt "#30105"
msgid "No RTL-SDR USB stick found"
msgstr "Kein RTL-SDR-USB-Stick gefunden"

msgctxt "#30106"
msgid "rtl_tcp server not reachable"
msgstr "rtl_tcp-Server nicht erreichbar"

msgctxt "#30107"
msgid "The tuner is in use."
msgstr "Der Tuner wird gerade verwendet."

#. Signal status of the tuner
msgctxt "#30108"
msgid "Synchronised"
msgstr "Synchronisiert"

#. Signal status of the tuner
msgctxt "#30109"
msgid "No signal"
msgstr "Kein Signal"

msgctxt "#30110"
msgid "The rtl_tcp server {0:s} is in use by another device."
msgstr "Der rtl_tcp-Server {0:s} wird gerade von einem anderen Gerät verwendet."

msgctxt "#30111"
msgid "The RTL-SDR USB stick is in use by another program."
msgstr "Der RTL-SDR-USB-Stick wird gerade von einem anderen Programm verwendet."

msgctxt "#30112"
msgid "Update programme guide and logos"
msgstr "Programmübersicht und Logos aktualisieren"

msgctxt "#30113"
msgid "Updating programme guide and logos. This can take a while."
msgstr "Programmübersicht und Logos werden aktualisiert. Das kann eine Weile dauern."
